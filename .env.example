# Use the managed DATABASE_URL when available; SQLite is the local fallback.
DATABASE_URL=sqlite+aiosqlite:///./data/smartapply.db
# The managed service contract supplies these at runtime when enabled.
MANUS_API_URL=
MANUS_API_KEY=
# Optional external vision provider. Never expose this in frontend code.
OPENAI_API_KEY=
MAX_UPLOAD_MB=10
